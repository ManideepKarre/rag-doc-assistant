# Postgres connection string (docker-compose sets this automatically for the
# backend service; only needed if running the backend outside Docker)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ragdb

# Optional: enables LLM-generated answers via OpenAI's API instead of the
# extractive fallback. Leave unset to run the app with zero paid API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000
